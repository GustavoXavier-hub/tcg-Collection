<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Guia: o código fica no canto inferior direito da carta. -->
    <View
        android:layout_width="260dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_mira" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtDica"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnLanterna"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_lanterna"
            android:src="@drawable/ic_lanterna"
            android:visibility="gone"
            app:tint="@color/mira" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFechar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_fechar"
        android:src="@drawable/ic_fechar"
        app:tint="#FFFFFF" />
</FrameLayout>
